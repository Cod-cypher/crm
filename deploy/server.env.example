# Template for /opt/twenty/packages/twenty-server/.env on the server (chmod 600).
# Real values live only on the server; never commit them.
NODE_ENV=production
NODE_PORT=3020
SERVER_URL=https://crm.optimizeindex.com
FRONTEND_URL=https://crm.optimizeindex.com

# Own role + database on the server's Postgres 18 (password: /root/.twenty/db_password)
PG_DATABASE_URL=postgres://twenty:CHANGE_ME@127.0.0.1:5432/twenty
REDIS_URL=redis://127.0.0.1:6379

# openssl rand -base64 32 (stored in /root/.twenty/app_secret). Changing it logs everyone out.
APP_SECRET=CHANGE_ME

# Uploads live outside the repo so deploys never touch them.
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/opt/twenty-data/storage

IS_BILLING_ENABLED=false
SIGN_IN_PREFILLED=false
SERVER_KEEP_ALIVE_TIMEOUT_MS=65000

# Outbound mail through the OptimizeIndex mailcow server (same login as optimizeindex.com).
EMAIL_DRIVER=SMTP
EMAIL_SMTP_HOST=mail.optimizeindex.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=ali@optimizeindex.com
EMAIL_SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM_ADDRESS=leads@optimizeindex.com
EMAIL_FROM_NAME="OptimizeIndex CRM"
